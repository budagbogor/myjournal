# ==========================================
# SCHOLARA ACADEMIC ENGINE ENVIRONMENT CONFIG
# ==========================================

# Port server lokal atau cloud (default: 3000)
PORT=3000

# Kunci API Google Gemini (Direkomendasikan untuk Terjemahan Cerdas, DeepSearch & Copilot Naskah)
# Dapatkan secara gratis di https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# Provider Tambahan (Opsional jika ingin multi-provider):
# SUMOPOD_API_KEY="sp_..."           # Dapatkan di https://ai.sumopod.com/ (Gateway lokal Indonesia via QRIS/IDR)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Lingkungan operasional ('development' atau 'production')
NODE_ENV=development
